{
    "name": "knplabs/gaufrette-extras",
    "description": "Provides extra features (prefixed fs, resolvable fs) to Gaufrette",
    "type": "library",
    "require": {
        "php": "^7.4 || ^8.0",
        "knplabs/gaufrette": "^0.11"
    },
    "require-dev": {
        "aws/aws-sdk-php": "~2.4|~3",
        "phpspec/phpspec": "^7.0 || ^8.0",
        "phpunit/phpunit": "^9||^10||^11||^12||^13",
        "symfony/phpunit-bridge": "^5.4 || ^6.4 || ^7.0"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Albin Kerouanton",
            "email": "albin.kerouanton@knplabs.com"
        },
        {
            "name": "KnpLabs Team",
            "homepage": "http://knplabs.com"
        },
        {
            "name":     "The contributors",
            "homepage": "http://github.com/Gaufrette/extras/contributors"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "bin-dir": "bin/",
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Gaufrette\\Extras\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gaufrette\\Extras\\Tests\\": "tests/"
        }
    },
    "scripts": {
      "phpspec": "phpspec run",
      "phpunit": "phpunit"
    }
}
